{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedit-audit:schema:metric-result:1.0.0",
  "title": "KEditAudit MetricResult",
  "description": "A versioned metric aggregate with coverage, raw per-probe evidence, warnings, and citations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metric_id",
    "status",
    "direction",
    "unit",
    "aggregate",
    "reduction",
    "coverage",
    "probes",
    "warnings",
    "citations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "metric_id": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "higher-is-better",
        "lower-is-better",
        "descriptive-only"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "aggregate": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "reduction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "threshold": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/threshold"
        }
      ]
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "probes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/probeEvidence"
      }
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/citation"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "aggregate": {
            "type": "number"
          },
          "coverage": {
            "properties": {
              "evaluated": {
                "minimum": 1
              },
              "missing": {
                "const": 0
              },
              "fraction": {
                "const": 1.0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "incomplete",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "warnings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "aggregate": {
            "const": null
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "evaluated",
        "missing",
        "fraction"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "probeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "status",
        "values",
        "missing_reason"
      ],
      "properties": {
        "probe_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "evaluated",
            "missing",
            "failed"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "missing_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "evaluated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "missing_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "value",
        "passed"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "greater-than",
            "greater-than-or-equal",
            "less-than",
            "less-than-or-equal"
          ]
        },
        "value": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
