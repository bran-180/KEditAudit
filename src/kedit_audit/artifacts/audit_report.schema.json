{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedit-audit:schema:audit-report:1.0.0",
  "title": "KEditAudit AuditReport",
  "description": "The authoritative structured evidence artifact for one KEditAudit run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "status",
    "generated_at",
    "manifest",
    "audit_case",
    "metrics",
    "structural_evidence",
    "limitations",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete",
        "failed"
      ]
    },
    "generated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "manifest": {
      "$ref": "urn:kedit-audit:schema:run-manifest:1.0.0"
    },
    "audit_case": {
      "$ref": "#/$defs/auditCaseMetadata"
    },
    "metrics": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "urn:kedit-audit:schema:metric-result:1.0.0"
      }
    },
    "structural_evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/structuralEvidence"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "incomplete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "incomplete",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "warnings": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "datasetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "license",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "auditCaseMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "schema_version",
        "artifact",
        "dataset"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "urn:kedit-audit:schema:run-manifest:1.0.0#/$defs/artifactReference"
            },
            {
              "properties": {
                "kind": {
                  "const": "audit-case"
                }
              }
            }
          ]
        },
        "dataset": {
          "$ref": "#/$defs/datasetMetadata"
        }
      }
    },
    "structuralEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "status",
        "values",
        "warnings",
        "citations"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_type": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete",
            "failed"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "incomplete",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
