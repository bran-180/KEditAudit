{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kedit-audit.dev/schemas/ripple-case/1.0.0",
  "title": "KEditAudit RippleCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "artifact_kind",
    "edit",
    "provenance",
    "probes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "case_id": { "$ref": "#/$defs/identifier" },
    "artifact_kind": {
      "enum": ["synthetic-contract-fixture", "external-benchmark-case"]
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "prompt", "target_new"],
      "properties": {
        "subject": { "$ref": "#/$defs/text" },
        "prompt": { "$ref": "#/$defs/text" },
        "target_new": { "$ref": "#/$defs/text" },
        "target_original": { "$ref": "#/$defs/text" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_name",
        "dataset_revision",
        "dataset_license",
        "source_url",
        "source_revision"
      ],
      "properties": {
        "dataset_name": { "$ref": "#/$defs/text" },
        "dataset_revision": { "$ref": "#/$defs/text" },
        "dataset_license": { "$ref": "#/$defs/text" },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^@\\s]+$",
          "maxLength": 2048
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "upstream_case_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_specificity",
        "logical_generalization",
        "subject_aliasing",
        "compositionality_i",
        "compositionality_ii",
        "forgetfulness"
      ],
      "properties": {
        "relation_specificity": { "$ref": "#/$defs/probe_group" },
        "logical_generalization": { "$ref": "#/$defs/probe_group" },
        "subject_aliasing": { "$ref": "#/$defs/probe_group" },
        "compositionality_i": { "$ref": "#/$defs/probe_group" },
        "compositionality_ii": { "$ref": "#/$defs/probe_group" },
        "forgetfulness": { "$ref": "#/$defs/probe_group" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": ".*\\S.*"
    },
    "probe_group": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/probe" }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "prompt", "expectation", "expected_answers"],
      "properties": {
        "probe_id": { "$ref": "#/$defs/identifier" },
        "prompt": { "$ref": "#/$defs/text" },
        "expectation": {
          "enum": ["edited-target", "baseline-preservation"]
        },
        "expected_answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "relation": { "$ref": "#/$defs/identifier" },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "queries"],
          "properties": {
            "operator": { "enum": ["all", "any"] },
            "queries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["prompt", "expected_answers"],
                "properties": {
                  "prompt": { "$ref": "#/$defs/text" },
                  "expected_answers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/text" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
